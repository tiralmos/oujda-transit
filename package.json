{
  "name": "oujda-transit",
  "version": "1.0.0",
  "description": "Bus stops, lines and trip planning for Oujda, Morocco, on OpenStreetMap.",
  "private": true,
  "main": "src/server.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/server.js",
    "gtfs": "node src/export-gtfs.js",
    "gtfs:validate": "node src/export-gtfs.js && sh tools/gtfs-validator/validate.sh",
    "test": "node --test test/*.test.js"
  }
}
